worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    server {
        listen ${PORT};
        server_name _;

        # Chat frontend — static files at the root
        root /app/frontend;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # Rasa's REST channel
        location /webhooks/ {
            proxy_pass http://127.0.0.1:5005/webhooks/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 120s;
        }

        # Admin console static files — HTTP Basic Auth gate (outer layer,
        # see architecture diagram), on top of the app's own login (inner
        # layer, handled by admin/index.html itself via /api/login)
        location /admin/ {
            alias /app/admin/;
            index index.html;
            try_files $uri $uri/ /admin/index.html;

            auth_basic "EcoVoyage Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
        }

        # Admin API — no nginx Basic Auth here (see architecture diagram:
        # Basic Auth gates reaching the Admin Console page itself, not each
        # individual API call underneath it). The app's own login (bearer
        # token, admin_api.py) is the real authentication layer for actual
        # data access. Gating /api/ with Basic Auth too caused browsers to
        # repeatedly re-prompt for nginx credentials on every fetch() call
        # the admin JS makes (including its own /api/login request),
        # since browsers handle Basic Auth differently for programmatic
        # requests than for page navigation.
        location /api/ {
            proxy_pass http://127.0.0.1:5002/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}