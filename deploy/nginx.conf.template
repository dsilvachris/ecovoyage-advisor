worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;

    server {
        listen ${PORT};
        server_name _;

        # Chat frontend — static files at the root
        root /app/frontend;
        index index.html;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # Rasa's REST channel
        location /webhooks/ {
            proxy_pass http://127.0.0.1:5005/webhooks/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 120s;
        }

        # Admin console static files — HTTP Basic Auth gate (outer layer,
        # see architecture diagram), on top of the app's own login (inner
        # layer, handled by admin/index.html itself via /api/login)
        location /admin/ {
            alias /app/admin/;
            index index.html;
            try_files $uri $uri/ /admin/index.html;

            auth_basic "EcoVoyage Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;
        }

        # Admin API — same Basic Auth gate
        location /api/ {
            auth_basic "EcoVoyage Admin";
            auth_basic_user_file /etc/nginx/.htpasswd;

            proxy_pass http://127.0.0.1:5002/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}