# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real keys.

# --- Database (required — primary data store) ---
NEON_DATABASE_URL=postgresql://user:password@ep-example.neon.tech/ecovoyage?sslmode=require

# --- External APIs (all optional; each action degrades gracefully without it) ---
CLIMATIQ_API_KEY=
OPENROUTESERVICE_API_KEY=
OPENCAGE_API_KEY=
AVIATIONSTACK_API_KEY=

# --- Admin console (HTTP Basic Auth, enforced at the nginx layer) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- ngrok (only needed for the Colab/local backup demo, later) ---
NGROK_AUTH_TOKEN=
